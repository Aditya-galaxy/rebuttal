# mock = in-memory PayPal with demo disputes (no accounts needed); sandbox = PayPal sandbox API
PAYPAL_MODE=mock

# Sandbox REST app credentials, from developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook id from the same app, subscribed to CUSTOMER.DISPUTE.* events
PAYPAL_WEBHOOK_ID=

# Any OpenAI-compatible chat API with tool calls. Leave the key empty to use template plans.
LLM_API_KEY=
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1/
LLM_MODEL=deepseek-ai/DeepSeek-V4-Pro

DATA_DIR=data

# Insights: an optional AI assistant inside the AG Studio report. Off by default; it works best
# with OpenAI models. Set all three to turn it on.
INSIGHTS_AI=
INSIGHTS_LLM_API_KEY=
INSIGHTS_LLM_MODEL=gpt-5.4-mini
# AG Studio licence key (the free 45-day trial removes the watermark)
AG_STUDIO_LICENSE_KEY=

# Google Cloud Vertex AI: Gemini for the dispute agent, the photo check and the Insights assistant.
# Uses Application Default Credentials (gcloud auth application-default login, or the Cloud Run service
# account with roles/aiplatform.user). Leave empty to use LLM_* (Nebius) and turn photo checks off.
VERTEX_PROJECT=
VERTEX_LOCATION=global
